.container.sakura .top5-bar { background: linear-gradient(90deg, #e91e63, #f48fb1); }
.container.sakura .mo-bar { background: linear-gradient(90deg, #e91e63, #ffcdd2); }
.container.sakura .mode-tab.active { color: #e91e63; box-shadow: 0 4rpx 16rpx rgba(233,30,99,0.2); }
.container.sakura .month-cell.active { background: #e91e63; }
.container.sakura .dual-card.love { background: linear-gradient(135deg, #fff5f5, #fce4ec); }
.container.sakura .dual-card.cold { background: linear-gradient(135deg, #fce4ec, #f8bbd0); }

