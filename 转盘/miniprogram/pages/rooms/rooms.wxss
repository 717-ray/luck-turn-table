/**pages/rooms/rooms.wxss**/
page {
  min-height: 100vh;
  overflow-x: hidden;
}

/* ========== 基础布局 ========== */
.container {
  min-height: 100vh;
  display: flex;
  flex-direction: column;
  padding: 0 30rpx;
}

/* ========== 头部 ========== */
.header {
  padding: 40rpx 0 20rpx;
  text-align: center;
}

.header-title {
  font-size: 44rpx;
  font-weight: 800;
  margin-bottom: 8rpx;
}

.header-sub {
  font-size: 26rpx;
  opacity: 0.55;
}

/* ========== 模式切换 ========== */
.mode-switch {
  display: flex;
  background: rgba(255,255,255,0.5);
  border-radius: 40rpx;
  padding: 6rpx;
  margin-bottom: 20rpx;
}

.mode-tab {
  flex: 1;
  text-align: center;
  padding: 16rpx 0;
  font-size: 28rpx;
  font-weight: 600;
  border-radius: 34rpx;
  transition: all 0.3s;
  color: rgba(0,0,0,0.45);
}

.mode-tab.active {
  background: #fff;
  color: #1677FF;
  box-shadow: 0 4rpx 16rpx rgba(22,119,255,0.15);
}

/* ========== 年份选择器 ========== */
.year-picker {
  display: flex;
  align-items: center;
  justify-content: center;
  gap: 40rpx;
  margin-bottom: 20rpx;
}

.year-arrow {
  width: 56rpx;
  height: 56rpx;
  border-radius: 50%;
  background: rgba(255,255,255,0.6);
  display: flex;
  align-items: center;
  justify-content: center;
  font-size: 24rpx;
  color: #333;
}

.year-arrow:active {
  background: rgba(255,255,255,0.9);
  transform: scale(0.92);
}

.year-text {
  font-size: 36rpx;
  font-weight: 700;
}

/* ========== 月份网格 ========== */
.month-picker {
  display: flex;
  align-items: center;
  justify-content: center;
  gap: 40rpx;
  margin-bottom: 16rpx;
}

.month-grid {
  display: flex;
  flex-wrap: wrap;
  gap: 12rpx;
  margin-bottom: 20rpx;
  justify-content: center;
}

.month-cell {
  width: 100rpx;
  height: 60rpx;
  border-radius: 30rpx;
  background: rgba(255,255,255,0.5);
  display: flex;
  align-items: center;
  justify-content: center;
  font-size: 24rpx;
  font-weight: 600;
  color: rgba(0,0,0,0.5);
  transition: all 0.2s;
}

.month-cell.active {
  background: #1677FF;
  color: #fff;
  box-shadow: 0 4rpx 16rpx rgba(22,119,255,0.3);
}

/* ========== 加载/空状态 ========== */
.loading-block {
  text-align: center;
  padding: 100rpx 0;
}

.loading-text {
  font-size: 28rpx;
  opacity: 0.5;
  animation: pulse 1.5s ease infinite;
}

@keyframes pulse {
  0%, 100% { opacity: 0.5; }
  50% { opacity: 1; }
}

.empty-block {
  text-align: center;
  padding: 80rpx 0;
}

.empty-icon {
  font-size: 80rpx;
  margin-bottom: 20rpx;
}

.empty-text {
  display: block;
  font-size: 28rpx;
  font-weight: 600;
  color: rgba(0,0,0,0.5);
  margin-bottom: 12rpx;
}

.empty-hint {
  font-size: 24rpx;
  color: rgba(0,0,0,0.35);
}

/* ========== 称号卡片 ========== */
.title-card {
  background: linear-gradient(135deg, #667eea 0%, #764ba2 100%);
  border-radius: 24rpx;
  padding: 32rpx;
  margin-bottom: 24rpx;
  box-shadow: 0 8rpx 32rpx rgba(102,126,234,0.3);
  text-align: center;
}

.title-text {
  display: block;
  font-size: 40rpx;
  font-weight: 800;
  color: #fff;
  margin-bottom: 8rpx;
}

.title-sub {
  display: block;
  font-size: 24rpx;
  color: rgba(255,255,255,0.8);
  line-height: 1.6;
}

/* ========== 核心数据网格 ========== */
.stats-grid {
  display: grid;
  grid-template-columns: 1fr 1fr;
  gap: 16rpx;
  margin-bottom: 24rpx;
}

.stat-card {
  background: rgba(255,255,255,0.75);
  border-radius: 20rpx;
  padding: 24rpx;
  text-align: center;
  box-shadow: 0 4rpx 12rpx rgba(0,0,0,0.04);
}

.stat-num {
  display: block;
  font-size: 44rpx;
  font-weight: 800;
  color: #1677FF;
  margin-bottom: 4rpx;
}

.stat-label {
  font-size: 22rpx;
  color: rgba(0,0,0,0.45);
}

/* ========== 高亮卡片 ========== */
.highlight-card {
  background: rgba(255,255,255,0.75);
  border-radius: 20rpx;
  padding: 24rpx;
  margin-bottom: 16rpx;
  display: flex;
  align-items: center;
  gap: 20rpx;
  box-shadow: 0 4rpx 12rpx rgba(0,0,0,0.04);
}

.hl-emoji {
  font-size: 48rpx;
  flex-shrink: 0;
}

.hl-content {
  flex: 1;
  display: flex;
  flex-direction: column;
  gap: 4rpx;
}

.hl-title {
  font-size: 26rpx;
  font-weight: 700;
  color: #333;
}

.hl-desc {
  font-size: 24rpx;
  color: rgba(0,0,0,0.55);
  line-height: 1.5;
}

.hl-num {
  color: #ff4757;
  font-weight: 800;
}

/* ========== 双栏卡片 ========== */
.dual-cards {
  display: flex;
  gap: 16rpx;
  margin-bottom: 16rpx;
}

.dual-card {
  flex: 1;
  border-radius: 20rpx;
  padding: 24rpx;
  text-align: center;
  box-shadow: 0 4rpx 12rpx rgba(0,0,0,0.04);
}

.dual-card.love {
  background: linear-gradient(135deg, #fff5f5, #ffe0e0);
}

.dual-card.cold {
  background: linear-gradient(135deg, #f0f4ff, #dbe4ff);
}

.dc-emoji {
  font-size: 36rpx;
  display: block;
  margin-bottom: 8rpx;
}

.dc-title {
  font-size: 22rpx;
  color: rgba(0,0,0,0.4);
  display: block;
  margin-bottom: 4rpx;
}

.dc-value {
  font-size: 32rpx;
  font-weight: 800;
  display: block;
  margin-bottom: 4rpx;
  color: #333;
}

.dc-count {
  font-size: 20rpx;
  color: rgba(0,0,0,0.4);
}

/* ========== 放弃卡片 ========== */
.giveup-card {
  background: rgba(255,255,255,0.75);
  border-radius: 20rpx;
  padding: 24rpx;
  margin-bottom: 24rpx;
  display: flex;
  align-items: center;
  gap: 20rpx;
  box-shadow: 0 4rpx 12rpx rgba(0,0,0,0.04);
}

.gu-emoji {
  font-size: 48rpx;
  flex-shrink: 0;
}

.gu-content {
  flex: 1;
  display: flex;
  flex-direction: column;
  gap: 4rpx;
}

.gu-title {
  font-size: 26rpx;
  font-weight: 700;
  color: #333;
}

.gu-desc {
  font-size: 24rpx;
  color: rgba(0,0,0,0.5);
  line-height: 1.5;
}

/* ========== TOP 5 ========== */
.top5-section {
  margin-bottom: 24rpx;
}

.section-title {
  display: block;
  font-size: 28rpx;
  font-weight: 700;
  color: #333;
  margin-bottom: 16rpx;
}

.top5-list {
  background: rgba(255,255,255,0.75);
  border-radius: 20rpx;
  padding: 8rpx 20rpx;
  box-shadow: 0 4rpx 12rpx rgba(0,0,0,0.04);
}

.top5-item {
  display: flex;
  align-items: center;
  gap: 12rpx;
  padding: 16rpx 0;
  border-bottom: 1rpx solid rgba(0,0,0,0.04);
}

.top5-item:last-child {
  border-bottom: none;
}

.top5-rank {
  font-size: 24rpx;
  font-weight: 700;
  color: #1677FF;
  width: 48rpx;
  flex-shrink: 0;
}

.top5-text {
  font-size: 26rpx;
  font-weight: 600;
  color: #333;
  flex-shrink: 0;
  width: 140rpx;
  overflow: hidden;
  text-overflow: ellipsis;
  white-space: nowrap;
}

.top5-bar-wrap {
  flex: 1;
  height: 12rpx;
  background: rgba(0,0,0,0.06);
  border-radius: 6rpx;
  overflow: hidden;
}

.top5-bar {
  height: 100%;
  background: linear-gradient(90deg, #1677FF, #4096ff);
  border-radius: 6rpx;
  min-width: 8rpx;
  transition: width 0.6s ease;
}

.top5-count {
  font-size: 22rpx;
  color: rgba(0,0,0,0.4);
  flex-shrink: 0;
  width: 56rpx;
  text-align: right;
}

/* ========== 月度热力 ========== */
.monthly-section {
  margin-bottom: 24rpx;
}

.monthly-grid {
  background: rgba(255,255,255,0.75);
  border-radius: 20rpx;
  padding: 20rpx;
  box-shadow: 0 4rpx 12rpx rgba(0,0,0,0.04);
}

.monthly-cell {
  display: flex;
  align-items: center;
  gap: 12rpx;
  padding: 8rpx 0;
}

.mo-label {
  font-size: 22rpx;
  font-weight: 600;
  color: rgba(0,0,0,0.45);
  width: 56rpx;
  flex-shrink: 0;
}

.mo-bar-wrap {
  flex: 1;
  height: 16rpx;
  background: rgba(0,0,0,0.04);
  border-radius: 8rpx;
  overflow: hidden;
}

.mo-bar {
  height: 100%;
  background: linear-gradient(90deg, #ff6b6b, #ffd93d);
  border-radius: 8rpx;
  min-width: 8rpx;
  transition: width 0.6s ease;
}

.mo-count {
  font-size: 22rpx;
  font-weight: 700;
  color: #333;
  width: 56rpx;
  text-align: right;
  flex-shrink: 0;
}

.mo-top {
  font-size: 20rpx;
  color: rgba(0,0,0,0.35);
  width: 120rpx;
  flex-shrink: 0;
  overflow: hidden;
  text-overflow: ellipsis;
  white-space: nowrap;
}

/* ========== 底部 ========== */
.footer-card {
  background: rgba(255,255,255,0.5);
  border-radius: 20rpx;
  padding: 20rpx;
  text-align: center;
  margin-bottom: 16rpx;
}

.footer-text {
  font-size: 22rpx;
  color: rgba(0,0,0,0.4);
}

.bottom-spacer {
  height: 60rpx;
}

/* ========== 主题配色 ========== */

/* 樱花粉 */
