/**index.wxss**/
page {
  min-height: 100vh;
  overflow-x: hidden;
}

/* ========== 主题系统 ========== */
/* 赛博朋克（默认） */
.container.cyberpunk {
  background: linear-gradient(135deg, #1a1a2e 0%, #16213e 50%, #0f0f23 100%);
}

.container.cyberpunk .title {
  color: #00fff5;
  text-shadow: 0 0 40rpx rgba(0, 255, 245, 0.6), 0 0 80rpx rgba(0, 255, 245, 0.3);
}

.container.cyberpunk .subtitle,
.container.cyberpunk .theme-hint { 
  color: rgba(0, 255, 245, 0.6); 
}

.container.cyberpunk .result { 
  background: linear-gradient(135deg, rgba(0, 255, 245, 0.1), rgba(0, 255, 245, 0.05)); 
  border-color: rgba(0, 255, 245, 0.4); 
}

.container.cyberpunk .result-text { 
  color: #00fff5 !important; 
  text-shadow: 0 0 30rpx rgba(0, 255, 245, 0.8);
}

.container.cyberpunk .result-label { color: rgba(255, 255, 255, 0.8); }
.container.cyberpunk .result-hint text { color: rgba(255, 255, 255, 0.5); }

.container.cyberpunk .input { 
  border-color: rgba(0, 255, 245, 0.3); 
  background: rgba(255, 255, 255, 0.08); 
  color: #fff; 
}
.container.cyberpunk .input::placeholder { color: rgba(255, 255, 255, 0.3); }

.container.cyberpunk .preset-btn { 
  border-color: rgba(0, 255, 245, 0.3); 
  color: rgba(255, 255, 255, 0.8); 
  background: rgba(0, 255, 245, 0.05);
}

.container.cyberpunk .preset-btn:active {
  background: rgba(0, 255, 245, 0.2);
  transform: scale(0.95);
}

.container.cyberpunk .spin-btn { 
  background: linear-gradient(135deg, #ff4757, #ff6b81, #ff4757) !important;
  box-shadow: 0 8rpx 40rpx rgba(255, 71, 87, 0.5), 0 0 60rpx rgba(255, 71, 87, 0.2);
}

.container.cyberpunk .reset-btn {
  background: rgba(255, 255, 255, 0.1) !important;
  color: rgba(255, 255, 255, 0.9) !important;
}

.container.cyberpunk .sound-btn {
  background: rgba(255, 255, 255, 0.1) !important;
  width: 100rpx !important;
}

.container.cyberpunk .history-section { 
  background: rgba(255, 255, 255, 0.03); 
  border-color: rgba(0, 255, 245, 0.2); 
}

.container.cyberpunk .history-header { color: rgba(255, 255, 255, 0.9); }
.container.cyberpunk .history-item { background: rgba(255, 255, 255, 0.05); }
.container.cyberpunk .history-choices { color: rgba(255, 255, 255, 0.6); }
.container.cyberpunk .history-result { color: #00fff5; }

.container.cyberpunk .shake-indicator { 
  background: rgba(0, 0, 0, 0.4); 
  border: 1rpx solid rgba(0, 255, 245, 0.2);
}
.container.cyberpunk .shake-indicator.active { 
  background: rgba(0, 255, 245, 0.1); 
  border-color: rgba(0, 255, 245, 0.4);
}
.container.cyberpunk .shake-text { color: rgba(255, 255, 255, 0.7); }

.container.cyberpunk .wheel-border { border-color: rgba(255, 255, 255, 0.4); }
.container.cyberpunk .wheel-center { background: linear-gradient(135deg, #1a1a2e, #0f0f23); }
.container.cyberpunk .wheel-center-inner { color: #00fff5; }
.container.cyberpunk .wheel-glow { background: radial-gradient(circle, rgba(0, 255, 245, 0.15) 0%, transparent 70%); }
.container.cyberpunk .color-btn { background: rgba(0, 255, 245, 0.2); }

