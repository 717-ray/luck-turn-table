/**pages/list/list.wxss**/

/* ========== 基础布局 ========== */
page {
  min-height: 100vh;
}

.container {
  display: flex;
  flex-direction: column;
  height: 100vh;
}

/* ========== 二级Tab导航 ========== */
.tab-nav {
  display: flex;
  justify-content: center;
  gap: 60rpx;
  padding: 32rpx 0 0;
  position: relative;
  z-index: 10;
}

.tab-item {
  font-size: 30rpx;
  color: #999;
  padding: 16rpx 0 20rpx;
  position: relative;
  transition: all 0.25s ease;
  text-align: center;
}

.tab-item.active {
  color: #1677FF;
  font-weight: 600;
}

.tab-item.active::after {
  content: '';
  position: absolute;
  bottom: 0;
  left: 50%;
  transform: translateX(-50%);
  width: 48rpx;
  height: 6rpx;
  background: #1677FF;
  border-radius: 3rpx;
}

/* ========== 滚动列表 ========== */
.list-scroll {
  flex: 1;
  padding: 24rpx 30rpx 0;
}

/* ========== 列表项 ========== */
.list-item {
  display: flex;
  align-items: center;
  justify-content: space-between;
  border-radius: 20rpx;
  padding: 28rpx 28rpx;
  margin-bottom: 16rpx;
  transition: all 0.2s ease;
}

.list-item:active {
  transform: scale(0.98);
}

/* 左侧内容 */
.item-left {
  display: flex;
  align-items: center;
  gap: 24rpx;
  flex: 1;
  overflow: hidden;
}

.item-icon {
  width: 80rpx;
  height: 80rpx;
  border-radius: 20rpx;
  display: flex;
  align-items: center;
  justify-content: center;
  font-size: 42rpx;
  flex-shrink: 0;
}

.item-info {
  display: flex;
  flex-direction: column;
  gap: 6rpx;
  overflow: hidden;
}

.item-name {
  font-size: 30rpx;
  font-weight: 600;
  overflow: hidden;
  text-overflow: ellipsis;
  white-space: nowrap;
}

.item-count {
  font-size: 24rpx;
  overflow: hidden;
  text-overflow: ellipsis;
  white-space: nowrap;
}

.item-custom-options {
  color: rgba(22, 119, 255, 0.6);
}

.item-theme-tag {
  color: #2ecc71;
  font-weight: 600;
}

/* 右侧收藏按钮 */
.item-favorite {
  width: 64rpx;
  height: 64rpx;
  border-radius: 50%;
  display: flex;
  align-items: center;
  justify-content: center;
  flex-shrink: 0;
  transition: all 0.2s ease;
}

.item-favorite:active {
  transform: scale(1.2);
}

.star-icon {
  font-size: 38rpx;
  color: #ccc;
  transition: all 0.2s ease;
}

.item-favorite.favorited .star-icon {
  color: #ffc107;
}

/* ========== 自定义转盘入口 ========== */
.custom-add {
  border: 2rpx dashed rgba(0, 0, 0, 0.15);
  background: rgba(255, 255, 255, 0.5);
}

.custom-add:active {
  background: rgba(255, 255, 255, 0.7);
}

.custom-icon {
  background: rgba(22, 119, 255, 0.1);
}

.custom-arrow {
  font-size: 36rpx;
  opacity: 0.6;
}

.item-custom-hint {
  color: rgba(0, 0, 0, 0.35);
  font-style: italic;
}

/* ========== 空状态 ========== */
.empty-state {
  display: flex;
  flex-direction: column;
  align-items: center;
  justify-content: center;
  padding: 120rpx 0;
}

.empty-icon {
  font-size: 100rpx;
  margin-bottom: 24rpx;
  opacity: 0.5;
}

.empty-text {
  font-size: 30rpx;
  margin-bottom: 8rpx;
}

.empty-hint {
  font-size: 24rpx;
}

/* ========== 底部安全区 ========== */
.bottom-safe {
  height: 40rpx;
}

/* ========== 自定义转盘项标识 ========== */
.custom-item {
  border: 2rpx dashed rgba(22, 119, 255, 0.2);
}

.item-edit-btn {
  width: 60rpx;
  height: 60rpx;
  border-radius: 50%;
  display: flex;
  align-items: center;
  justify-content: center;
  flex-shrink: 0;
  background: rgba(22, 119, 255, 0.08);
}

.item-edit-btn:active {
  background: rgba(22, 119, 255, 0.18);
}

.edit-icon-text {
  font-size: 30rpx;
  color: #1677FF;
}

/* ========== 弹窗遮罩 ========== */
.modal-overlay {
  position: fixed;
  top: 0;
  left: 0;
  right: 0;
  bottom: 0;
  background: rgba(0, 0, 0, 0.45);
  z-index: 1000;
  display: flex;
  align-items: center;
  justify-content: center;
  visibility: hidden;
  opacity: 0;
  transition: visibility 0.25s, opacity 0.25s;
}

.modal-overlay.show {
  visibility: visible;
  opacity: 1;
}

/* 弹窗卡片 */
.modal-card {
  width: 620rpx;
  max-height: 80vh;
  background: #fff;
  border-radius: 24rpx;
  overflow: hidden;
  display: flex;
  flex-direction: column;
}

.modal-header {
  display: flex;
  align-items: center;
  justify-content: space-between;
  padding: 32rpx 32rpx 16rpx;
}

.modal-title {
  font-size: 34rpx;
  font-weight: 700;
  color: #1a1a1a;
}

.modal-close {
  width: 52rpx;
  height: 52rpx;
  border-radius: 50%;
  background: rgba(0, 0, 0, 0.06);
  display: flex;
  align-items: center;
  justify-content: center;
  font-size: 26rpx;
  color: #999;
}

.modal-close:active {
  background: rgba(0, 0, 0, 0.12);
}

/* 弹窗内容 */
.modal-body {
  flex: 1;
  padding: 0 32rpx 24rpx;
  overflow-y: auto;
}

.form-group {
  margin-bottom: 28rpx;
}

.form-label {
  font-size: 26rpx;
  font-weight: 600;
  color: #555;
  display: block;
  margin-bottom: 12rpx;
}

.form-input {
  width: 100%;
  height: 80rpx;
  background: #f5f6f8;
  border-radius: 14rpx;
  padding: 0 20rpx;
  font-size: 28rpx;
  box-sizing: border-box;
}

.form-textarea {
  width: 100%;
  min-height: 200rpx;
  max-height: 400rpx;
  background: #f5f6f8;
  border-radius: 14rpx;
  padding: 18rpx 20rpx;
  font-size: 26rpx;
  box-sizing: border-box;
  line-height: 1.6;
}

/* 弹窗底部按钮 */
.modal-footer {
  display: flex;
  gap: 20rpx;
  padding: 8rpx 32rpx 32rpx;
}

.modal-btn {
  flex: 1;
  height: 84rpx;
  border-radius: 42rpx;
  font-size: 30rpx;
  font-weight: 600;
  display: flex;
  align-items: center;
  justify-content: center;
  border: none;
  line-height: 84rpx;
}

.modal-btn::after {
  border: none;
}

.cancel-btn {
  background: #f0f1f3;
  color: #666;
}

.save-btn {
  background: linear-gradient(135deg, #1677FF, #4096ff);
  color: #fff;
}

/* ========== 樱花粉 ========== */
.container.sakura {
  background: linear-gradient(135deg, #fce4ec 0%, #f8bbd0 50%, #f48fb1 100%);
}

.container.sakura .tab-nav { background: transparent; }

.container.sakura .tab-item { color: rgba(136, 14, 79, 0.4); }
.container.sakura .tab-item.active { color: #c2185b; }
.container.sakura .tab-item.active::after { background: linear-gradient(135deg, #ec407a, #f06292); }

.container.sakura .list-item { background: rgba(255, 255, 255, 0.85); }
.container.sakura .list-item:active { background: rgba(255, 255, 255, 0.95); }
.container.sakura .item-icon { background: rgba(233, 30, 99, 0.1); }
.container.sakura .item-name { color: #880e4f; }
.container.sakura .item-count { color: rgba(136, 14, 79, 0.5); }
.container.sakura .item-custom-hint { color: rgba(136, 14, 79, 0.35); }
.container.sakura .custom-add { border-color: rgba(136, 14, 79, 0.2); background: rgba(255, 255, 255, 0.5); }
.container.sakura .custom-item { border-color: rgba(194, 24, 91, 0.25); }
.container.sakura .item-edit-btn { background: rgba(194, 24, 91, 0.08); }
.container.sakura .edit-icon-text { color: #c2185b; }
.container.sakura .empty-text { color: rgba(136, 14, 79, 0.6); }
.container.sakura .empty-hint { color: rgba(136, 14, 79, 0.4); }

