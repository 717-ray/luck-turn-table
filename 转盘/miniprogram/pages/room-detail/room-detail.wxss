/**pages/room-detail/room-detail.wxss**/

/* ========== 基础 ========== */
page {
  height: 100vh;
  overflow: hidden;
}

.container {
  display: flex;
  flex-direction: column;
  height: 100vh;
  overflow-y: auto;
  overflow-x: hidden;
  -webkit-overflow-scrolling: touch;
}

/* ========== 昵称弹窗 ========== */
.name-modal {
  position: fixed;
  top: 0; left: 0; right: 0; bottom: 0;
  background: rgba(0,0,0,0.55);
  z-index: 9999;
  display: flex;
  align-items: center;
  justify-content: center;
}

.name-card {
  width: 580rpx;
  background: #fff;
  border-radius: 28rpx;
  padding: 48rpx 36rpx 36rpx;
  display: flex;
  flex-direction: column;
  align-items: center;
  gap: 28rpx;
}

.name-title {
  font-size: 34rpx;
  font-weight: 700;
  color: #1a1a1a;
}

.name-input {
  width: 100%;
  height: 88rpx;
  background: #f5f6f8;
  border-radius: 16rpx;
  padding: 0 24rpx;
  font-size: 30rpx;
  box-sizing: border-box;
  text-align: center;
}

.name-btn {
  width: 100%;
  height: 88rpx;
  border-radius: 44rpx;
  background: linear-gradient(135deg, #1677FF, #4096ff);
  color: #fff;
  font-size: 30rpx;
  font-weight: 600;
  border: none;
  line-height: 88rpx;
}

/* ========== 组队头部 ========== */
.room-header {
  padding: 30rpx 30rpx 0;
  flex-shrink: 0;
}

.header-top {
  display: flex;
  justify-content: space-between;
  margin-bottom: 12rpx;
}

.back-btn {
  font-size: 28rpx;
  padding: 8rpx 20rpx;
  border-radius: 30rpx;
  background: rgba(255,255,255,0.6);
}

.share-btn {
  font-size: 26rpx;
  padding: 8rpx 24rpx;
  border-radius: 30rpx;
  background: rgba(255,255,255,0.6);
  border: none;
  line-height: 1.4;
}

.share-btn::after { border: none; }

.room-title {
  font-size: 40rpx;
  font-weight: 800;
  margin-bottom: 6rpx;
  text-align: center;
}

.room-meta {
  display: flex;
  justify-content: center;
  align-items: center;
  gap: 20rpx;
  margin-bottom: 8rpx;
}

.room-code-tag {
  font-size: 22rpx;
  padding: 4rpx 16rpx;
  border-radius: 20rpx;
  background: rgba(0,0,0,0.06);
  letter-spacing: 3rpx;
}

.room-status {
  font-size: 22rpx;
  font-weight: 600;
}

.status-waiting { color: #52c41a; }
.status-spinning { color: #ff9800; }
.status-finished { color: #1677FF; }

.members-row {
  display: flex;
  flex-wrap: wrap;
  justify-content: center;
  gap: 10rpx;
  margin-bottom: 4rpx;
}

.member-tag {
  font-size: 22rpx;
  padding: 4rpx 16rpx;
  border-radius: 20rpx;
  background: rgba(22,119,255,0.1);
  color: #1677FF;
}

/* ========== 转盘区 ========== */
.wheel-section {
  flex-shrink: 0;
  display: flex;
  flex-direction: column;
  align-items: center;
  padding: 50rpx 0 6rpx;
  position: relative;
  overflow: visible;
}

/* 转盘光晕 */
.wheel-glow {
  position: absolute;
  top: 50%;
  left: 50%;
  transform: translate(-50%, -50%);
  width: 500rpx;
  height: 500rpx;
  border-radius: 50%;
  pointer-events: none;
  animation: glowPulse 3s ease-in-out infinite;
}

@keyframes glowPulse {
  0%, 100% { opacity: 0.5; transform: translate(-50%, -50%) scale(1); }
  50% { opacity: 0.8; transform: translate(-50%, -50%) scale(1.05); }
}

/* 指针 */
.pointer {
  position: absolute;
  top: 4rpx;
  left: 50%;
  transform: translateX(-50%);
  z-index: 20;
  display: flex;
  flex-direction: column;
  align-items: center;
  filter: drop-shadow(0 8rpx 16rpx rgba(0, 0, 0, 0.4));
}

.pointer-inner {
  width: 0;
  height: 0;
  border-left: 24rpx solid transparent;
  border-right: 24rpx solid transparent;
  border-top: 60rpx solid #ff4757;
  position: relative;
}

.pointer-inner::after {
  content: '';
  position: absolute;
  top: -58rpx;
  left: -12rpx;
  width: 0;
  height: 0;
  border-left: 12rpx solid transparent;
  border-right: 12rpx solid transparent;
  border-top: 30rpx solid #ff6b81;
}

.pointer.spinning .pointer-inner {
  animation: pointerShake 0.1s ease infinite;
}

@keyframes pointerShake {
  0%, 100% { transform: translateX(0); }
  25% { transform: translateX(-2rpx); }
  75% { transform: translateX(2rpx); }
}

.wheel-canvas {
  border-radius: 50%;
  box-shadow: 
    0 20rpx 60rpx rgba(0, 0, 0, 0.5),
    inset 0 0 40rpx rgba(255, 255, 255, 0.1);
}

/* 转盘边框 */
.wheel-border {
  position: absolute;
  top: 50%;
  left: 50%;
  transform: translate(-50%, -50%);
  border-radius: 50%;
  border: 8rpx solid rgba(255, 255, 255, 0.8);
  pointer-events: none;
  z-index: 10;
}

/* 中心圆 */
.wheel-center {
  position: absolute;
  top: 50%;
  left: 50%;
  transform: translate(-50%, -50%);
  width: 100rpx;
  height: 100rpx;
  border-radius: 50%;
  display: flex;
  align-items: center;
  justify-content: center;
  z-index: 15;
  box-shadow: 0 4rpx 20rpx rgba(0, 0, 0, 0.3);
  border: 4rpx solid rgba(255, 255, 255, 0.3);
  background: linear-gradient(135deg, #fff, #fce4ec);
}

.wheel-center-inner {
  font-size: 32rpx;
  font-weight: bold;
  text-shadow: 0 2rpx 4rpx rgba(0, 0, 0, 0.2);
  color: #c2185b;
}

/* 换色按钮 */
.color-btn {
  position: absolute;
  bottom: 0rpx;
  right: 50%;
  transform: translateX(50%) translateX(130rpx);
  width: 70rpx;
  height: 70rpx;
  border-radius: 50%;
  display: flex;
  align-items: center;
  justify-content: center;
  font-size: 32rpx;
  box-shadow: 0 4rpx 20rpx rgba(0, 0, 0, 0.3);
  z-index: 20;
  background: rgba(233, 30, 99, 0.2);
  transition: all 0.3s ease;
}

.color-btn:active {
  transform: translateX(50%) translateX(130rpx) scale(0.9) rotate(30deg);
}

.result-banner {
  display: flex;
  flex-direction: column;
  align-items: center;
  margin-top: 12rpx;
  animation: resultPop 0.5s ease;
}

@keyframes resultPop {
  0% { transform: scale(0.5); opacity: 0; }
  70% { transform: scale(1.15); }
  100% { transform: scale(1); opacity: 1; }
}

.result-emoji {
  font-size: 48rpx;
  margin-bottom: 4rpx;
}

.result-text {
  font-size: 34rpx;
  font-weight: 800;
  color: #fff;
  background: linear-gradient(135deg, #ff6b6b, #ffd93d);
  padding: 10rpx 48rpx;
  border-radius: 50rpx;
}

.result-hint {
  font-size: 22rpx;
  color: rgba(0,0,0,0.4);
  margin-top: 4rpx;
}

/* ========== 选项面板 ========== */
.options-panel {
  flex-shrink: 0;
  overflow: hidden;
  margin: 10rpx 30rpx 0;
  border-radius: 20rpx;
  background: rgba(255,255,255,0.85);
  padding: 16rpx 24rpx;
  display: flex;
  flex-direction: column;
}

.panel-title {
  font-size: 26rpx;
  font-weight: 600;
  color: #555;
  margin-bottom: 10rpx;
  flex-shrink: 0;
}

.options-scroll {
  flex-shrink: 0;
  max-height: 200rpx;
}

.op-item {
  display: flex;
  align-items: center;
  gap: 10rpx;
  padding: 8rpx 0;
  border-bottom: 1rpx solid rgba(0,0,0,0.04);
}

.op-emoji {
  font-size: 28rpx;
  width: 40rpx;
  text-align: center;
  flex-shrink: 0;
}

.op-text {
  font-size: 28rpx;
  font-weight: 600;
  flex: 1;
}

.op-user {
  font-size: 22rpx;
  color: #999;
  flex-shrink: 0;
}

.empty-options {
  text-align: center;
  padding: 24rpx 0;
  font-size: 26rpx;
  color: #ccc;
}

/* ========== 底部操作栏 ========== */
.bottom-bar {
  flex-shrink: 0;
  padding: 12rpx 30rpx 30rpx;
  margin-top: auto;
}

.vote-row {
  display: flex;
  gap: 16rpx;
  align-items: center;
  margin-bottom: 12rpx;
}

.vote-input {
  flex: 1;
  height: 76rpx;
  background: #fff;
  border-radius: 38rpx;
  padding: 0 28rpx;
  font-size: 28rpx;
  box-shadow: 0 2rpx 12rpx rgba(0,0,0,0.06);
  box-sizing: border-box;
}

.vote-btn {
  width: 140rpx;
  height: 76rpx;
  border-radius: 38rpx;
  background: linear-gradient(135deg, #52c41a, #73d13d);
  color: #fff;
  font-size: 28rpx;
  font-weight: 600;
  border: none;
  line-height: 76rpx;
  padding: 0;
}

.spin-btn {
  width: 100%;
  height: 88rpx;
  border-radius: 44rpx;
  background: linear-gradient(135deg, #ff6b6b, #ffd93d);
  color: #fff;
  font-size: 34rpx;
  font-weight: 800;
  border: none;
  line-height: 88rpx;
  box-shadow: 0 8rpx 30rpx rgba(255,107,107,0.4);
  animation: pulse 1.5s ease infinite;
}

@keyframes pulse {
  0%, 100% { transform: scale(1); }
  50% { transform: scale(1.03); }
}

.spin-hint {
  text-align: center;
  font-size: 24rpx;
  color: #999;
  padding: 16rpx 0;
}

.voted-hint {
  text-align: center;
  font-size: 28rpx;
  color: #52c41a;
  font-weight: 600;
  padding: 16rpx 0;
  margin-bottom: 4rpx;
}

.spinning-hint {
  text-align: center;
  font-size: 30rpx;
  font-weight: 600;
  color: #ff9800;
  padding: 16rpx 0;
  animation: blink 0.8s ease infinite;
}

@keyframes blink {
  0%, 100% { opacity: 1; }
  50% { opacity: 0.4; }
}

.finished-bar {
  text-align: center;
  padding: 12rpx 0;
  display: flex;
  flex-direction: column;
  align-items: center;
  gap: 16rpx;
}

.finished-result {
  font-size: 28rpx;
  font-weight: 700;
  background: linear-gradient(135deg, #ff6b6b, #ffd93d);
  -webkit-background-clip: text;
  -webkit-text-fill-color: transparent;
  background-clip: text;
}

.spin-again-btn {
  width: 320rpx;
  height: 72rpx;
  border-radius: 36rpx;
  background: linear-gradient(135deg, #1677FF, #4096ff);
  color: #fff;
  font-size: 28rpx;
  font-weight: 600;
  border: none;
  line-height: 72rpx;
  box-shadow: 0 4rpx 16rpx rgba(22,119,255,0.3);
}

.spin-again-btn::after { border: none; }

.finished-hint {
  font-size: 24rpx;
  color: #999;
}

